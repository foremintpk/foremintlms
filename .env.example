# ─────────────────────────────────────────────────────────────────────────────
# Foremint Academy — environment variables
# Copy to .env.local for development. In Vercel, add them under
# Project → Settings → Environment Variables. Never commit real values.
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only.
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL (no trailing slash). Used for links in emails, OAuth
# redirects, sitemap and canonical URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. The publishable key (sb_publishable_…) or the legacy
# anon key both work for NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=https://avijlwhtadinxpfpddhi.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) or legacy service_role key. SERVER ONLY.
SUPABASE_SECRET_KEY=

# ── App security ────────────────────────────────────────────────────────────
# Generate both with:  npm run keys:generate
# 32-byte base64 key that encrypts integration secrets and OAuth tokens.
ENCRYPTION_KEY=
# Shared secret that Vercel Cron / pg_cron send to /api/cron/* endpoints.
CRON_SECRET=

# ── Whop (payments) ─────────────────────────────────────────────────────────
# Developer dashboard → API keys (company key with the permissions listed in
# docs/INTEGRATIONS.md) and Webhooks → signing secret.
WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_WEBHOOK_SECRET=
# production | sandbox
WHOP_ENVIRONMENT=production

# ── Resend (email) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
# Signing secret of the Resend webhook (delivery events). Optional.
RESEND_WEBHOOK_SECRET=
# Must be on a domain verified in Resend, e.g. "Foremint Academy <hello@mail.yourdomain.com>"
EMAIL_FROM=
SUPPORT_EMAIL=

# ── Video providers (configure any or all) ──────────────────────────────────
# Mux: Settings → Access tokens (Mux Video read/write) and Signing keys.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
# Base64-encoded private key exactly as Mux shows it.
MUX_SIGNING_PRIVATE_KEY=

# Bunny Stream: Stream → your library → API.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# Library → Security → Token authentication key (enables signed embeds).
BUNNY_STREAM_TOKEN_KEY=
# e.g. vz-xxxxxxxx-xxx.b-cdn.net
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_WEBHOOK_SECRET=

# YouTube (unlisted videos) needs no credentials.

# ── Zoom (live classes) ─────────────────────────────────────────────────────
# Zoom App Marketplace → General app (OAuth, user-managed).
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:3000/api/integrations/zoom/callback
# Event subscription → Secret token (webhook signature verification).
ZOOM_WEBHOOK_SECRET_TOKEN=

# ── Google (Meet live classes + optional "Continue with Google") ─────────────
# Google Cloud console → APIs & Services → Credentials → OAuth client (Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
